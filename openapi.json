{
  "openapi": "3.1.0",
  "info": {
    "title": "sea-orm-pro-frontend-ra",
    "description": "FrontEnd React-Admin for backend sea-orm-pro",
    "contact": { "name": "zhaolei", "email": "oizhaolei@gmail.com" },
    "license": { "name": "MIT" },
    "version": "0.1.0"
  },
  "servers": [{ "url": "http://localhost:8086" }],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login with email and password",
        "description": "Tries to login via a User in the database.",
        "operationId": "login",
        "requestBody": {
          "description": "login",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserAuth" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User login successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthBody" }
              }
            }
          }
        }
      }
    },
    "/api/users/current": {
      "get": {
        "tags": ["Users"],
        "summary": "Get single User by username",
        "description": "Tries to get single user by username from the database",
        "operationId": "view",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/UserBody" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthBody": {
        "type": "object",
        "required": ["access_token", "token_type"],
        "properties": {
          "is_verified": { "type": "boolean" },
          "pid": { "type": "string" },
          "token": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "UserBody": {
        "type": "object",
        "properties": {
          "pid": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "UserAuth": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "password": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    },
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } }
  },
  "tags": [
    { "name": "Auth", "description": "Auth management API" },
    { "name": "Users", "description": "Users management API" }
  ]
}
