{
  "openapi": "3.1.0",
  "info": {
    "title": "sea-orm-pro-frontend-ra",
    "description": "FrontEnd React-Admin for backend sea-orm-pro",
    "contact": { "name": "zhaolei", "email": "oizhaolei@gmail.com" },
    "license": { "name": "MIT" },
    "version": "0.1.0"
  },
  "servers": [{ "url": "http://localhost:8086" }],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "Try to login via a User in the database.",
        "operationId": "login",
        "requestBody": {
          "description": "login",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordLoginParams" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User login successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          }
        }
      }
    },
    "/api/admin/dashboard": {
      "post": {
        "tags": ["Admins"],
        "summary": "Graph data for dashboard",
        "description": "Graph data for dashboard",
        "operationId": "dashboard",
        "requestBody": {
          "description": "dashboard",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DashboardBody" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Retrieve graph data successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DashboardDatum"
                  }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/user/current": {
      "get": {
        "tags": ["Users"],
        "summary": "Get single User by username",
        "description": "Tries to get single user by username from the database",
        "operationId": "profile",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentResponse"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "PasswordLoginParams": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "password": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["pid", "name", "token"],
        "properties": {
          "is_verified": { "type": "boolean" },
          "pid": { "type": "string" },
          "token": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "DashboardBody": {
        "type": "object",
        "required": ["graph"],
        "properties": {
          "graph": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      },
      "DashboardDatum": {
        "type": "object",
        "required": ["key", "val"],
        "properties": {
          "key": { "type": "string" },
          "val": { "type": "string" }
        }
      },
      "Permission": {
        "type": "object",
        "required": ["name", "resource", "permission"],
        "properties": {
          "name": { "type": "string" },
          "resource": { "type": "string" },
          "permission": { "type": "string" }
        }
      },
      "CurrentResponse": {
        "type": "object",
        "required": ["pid", "email", "name", "permissions"],
        "properties": {
          "pid": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      }
    },
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } }
  },
  "tags": [
    { "name": "Auth", "description": "Auth management API" },
    { "name": "Users", "description": "Users management API" }
  ]
}
